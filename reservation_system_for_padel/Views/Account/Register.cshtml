@{
    ViewData["Title"] = "Registrace";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Registrace hráče</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2">@ViewBag.Error</div>
                }

                <form method="post" asp-action="Register">
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Jméno</label>
                            <input type="text" name="name" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">Příjmení</label>
                            <input type="text" name="surname" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Heslo</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100 mb-3">Zaregistrovat se</button>
                </form>

                <div class="text-center">
                    <small>Už máte účet? <a asp-action="Login">Přihlaste se</a></small>
                </div>
            </div>
        </div>
    </div>
</div>