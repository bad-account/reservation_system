@model IEnumerable<reservation_system_for_padel.Models.Reservation>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Rezervace ke schválení";
    ViewData["MinimalAdminLayout"] = true;

    var pendingReservations = Model?.ToList()
        ?? new List<reservation_system_for_padel.Models.Reservation>();
}

<style>
    .approval-page-container {
        max-width: 1180px;
        padding-top: 28px;
    }

    .approval-page-title {
        color: #0d6efd;
        font-size: 26px;
        font-weight: 600;
        margin: 0 0 18px;
    }

    .approval-count {
        display: inline-block;
        padding: 3px 9px;
        margin-left: 8px;
        border-radius: 4px;
        background: #e9ecef;
        color: #495057;
        font-size: 13px;
        vertical-align: 4px;
    }

    .approval-table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 4px;
        box-shadow: 0 .15rem .35rem rgba(0, 0, 0, .08);
    }

    .approval-table {
        width: 100%;
        min-width: 900px;
        margin-bottom: 0;
        border-collapse: collapse;
        color: #212529;
        font-size: 14px;
    }

        .approval-table thead th {
            padding: 10px 8px;
            background: #212529;
            color: white;
            border: 0;
            font-weight: 600;
            white-space: nowrap;
        }

        .approval-table tbody td {
            padding: 9px 8px;
            border-top: 1px solid #dee2e6;
            vertical-align: middle;
        }

        .approval-table tbody tr:nth-child(odd) {
            background: #f1f1f1;
        }

        .approval-table tbody tr:nth-child(even) {
            background: white;
        }

        .approval-table .date-cell,
        .approval-table .time-cell {
            white-space: nowrap;
        }

        .approval-table .user-name {
            display: block;
            font-weight: 600;
        }

        .approval-table .user-email {
            display: block;
            margin-top: 2px;
            color: #6c757d;
            font-size: 12px;
        }

        .approval-table .created-cell {
            color: #6c757d;
            white-space: nowrap;
            font-size: 13px;
        }

        .approval-table .actions-cell {
            text-align: right;
            white-space: nowrap;
        }

            .approval-table .actions-cell form {
                display: inline-block;
                margin-left: 3px;
            }

        .approval-table .btn {
            padding: 4px 9px;
            font-size: 12px;
        }

    .approval-empty {
        padding: 24px 16px;
        background: #f1f1f1;
        border: 1px solid #dee2e6;
        color: #495057;
        text-align: center;
    }

    @@media (max-width: 575.98px) {
        .approval-page-container {
            padding-top: 16px;
        }

        .approval-page-title {
            font-size: 23px;
        }
    }
</style>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h1 class="approval-page-title">
        Rezervace ke schválení
        <span class="approval-count">@pendingReservations.Count</span>
    </h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!pendingReservations.Any())
{
    <div class="approval-empty">
        <strong>Momentálně tu nejsou žádné žádosti.</strong>
        <div>Všechny rezervace jsou vyřízené.</div>
    </div>
}
else
{
    <div class="approval-table-wrapper">
        <table class="approval-table">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Čas</th>
                    <th>Kurt</th>
                    <th>Uživatel</th>
                    <th>Vytvořeno</th>
                    <th class="text-end">Akce</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in pendingReservations)
                {
                    var elapsed = DateTime.UtcNow - item.CreatedAt;

                    if (elapsed < TimeSpan.Zero)
                    {
                        elapsed = TimeSpan.Zero;
                    }

                    string createdAgo;

                    if (elapsed.TotalDays >= 1)
                    {
                        createdAgo = $"před {(int)elapsed.TotalDays} d {elapsed.Hours} h";
                    }
                    else if (elapsed.TotalHours >= 1)
                    {
                        createdAgo = $"před {(int)elapsed.TotalHours} h {elapsed.Minutes} min";
                    }
                    else if (elapsed.TotalMinutes >= 1)
                    {
                        createdAgo = $"před {(int)elapsed.TotalMinutes} min";
                    }
                    else
                    {
                        createdAgo = "právě teď";
                    }

                    <tr>
                        <td class="date-cell">
                            @item.Date.ToString("dd. MM. yyyy")
                        </td>

                        <td class="time-cell">
                            @item.TimeSlot.StartTime.ToString("HH:mm")
                            –
                            @item.TimeSlot.EndTime.ToString("HH:mm")
                        </td>

                        <td>
                            Kurt č. @item.Court.Number
                        </td>

                        <td>
                            <span class="user-name">
                                @item.User.Name @item.User.Surname
                            </span>
                            <span class="user-email">
                                @item.User.Email
                            </span>
                        </td>

                        <td class="created-cell">
                            @createdAgo
                        </td>

                        <td class="actions-cell">
                            <form asp-controller="Reservation"
                                  asp-action="Approve"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="reservationId"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-success">
                                    Schválit
                                </button>
                            </form>

                            <form asp-controller="Reservation"
                                  asp-action="Reject"
                                  method="post"
                                  onsubmit="return confirm('Opravdu chcete tuto rezervaci zamítnout?');">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="reservationId"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    Zamítnout
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
