@using reservation_system_for_padel.Models
@{
    ViewData["Title"] = "Rezervace kurtů na padel";
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var courts = (List<Court>)ViewBag.Courts;
    var timeSlots = (List<TimeSlot>)ViewBag.TimeSlots;
    var reservations = (List<Reservation>)ViewBag.Reservations;
    int? currentUserId = ViewBag.CurrentUserId;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-0 text-primary">Padel Ostrava – Rezervace kurtů</h1>
            <p class="text-muted small mb-0">Kliknutím na volný termín rezervujete kurt</p>
        </div>

        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label for="date" class="fw-bold mb-0">Datum:</label>
            <input type="date" id="date" name="date" class="form-control"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   onchange="this.form.submit()" />
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered align-middle text-center mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th style="width: 140px;">Čas</th>
                    @foreach (var court in courts)
                    {
                        <th>Kurt č. @court.Number</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in timeSlots)
                {
                    <tr>
                        <td class="fw-semibold bg-light">
                            @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                        </td>

                        @foreach (var court in courts)
                        {
                            var res = reservations.FirstOrDefault(r => r.CourtId == court.Id && r.TimeSlotId == slot.Id);

                            if (res != null)
                            {
                                bool isMine = currentUserId.HasValue && res.UserId == currentUserId.Value;

                                if (isMine)
                                {
                                    <td class="bg-primary-subtle p-2">
                                        <div class="badge bg-primary mb-1">Moje rezervace</div>
                                        <form method="post" asp-action="Cancel">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reservationId" value="@res.Id" />
                                            <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Opravdu chcete zrušit tuto rezervaci?');">
                                                Zrušit
                                            </button>
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <td class="bg-danger-subtle text-danger fw-semibold">
                                        <span class="badge bg-danger">Obsazeno</span>
                                        <div class="small text-muted mt-1">@res.User.Name @res.User.Surname[0].</div>
                                    </td>
                                }
                            }
                            else
                            {
                                <td class="bg-light-subtle">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form method="post" asp-action="BookSlot">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="courtId" value="@court.Id" />
                                            <input type="hidden" name="timeSlotId" value="@slot.Id" />
                                            <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-outline-success btn-sm px-3">
                                                Rezervovat
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login"
                                           asp-route-returnUrl="@Url.Action("Index", "Reservation", new { date = selectedDate.ToString("yyyy-MM-dd") })"
                                           class="btn btn-outline-secondary btn-sm">
                                            Přihlásit se
                                        </a>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>