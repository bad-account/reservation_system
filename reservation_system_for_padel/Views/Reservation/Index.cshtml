@using reservation_system_for_padel.Models
@{
    ViewData["Title"] = "Rezervace kurtů na padel";
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var courts = (List<Court>)ViewBag.Courts;
    var timeSlots = (List<TimeSlot>)ViewBag.TimeSlots;
    var reservations = (List<Reservation>)ViewBag.Reservations;
    int? currentUserId = ViewBag.CurrentUserId;

    var today = DateOnly.FromDateTime(DateTime.Now);

    int courtCount = courts.Count > 0 ? courts.Count : 1;
    string courtColumnWidth = $"{85.0 / courtCount}%";
}

<style>
    .table-fixed {
        table-layout: fixed;
        width: 100%;
    }

    .slot-cell {
        height: 54px;
        padding: 0 !important;
        vertical-align: middle;
    }

    .slot-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        text-decoration: none;
    }

    .cell-available {
        background-color: #e8f5e9;
        color: #2e7d32;
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.15s;
    }

        .cell-available:hover {
            background-color: #c8e6c9 !important;
            color: #1b5e20;
        }

    .cell-mine {
        background-color: #e3f2fd;
        color: #1565c0;
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.15s;
    }

        .cell-mine:hover {
            background-color: #bbdefb !important;
            color: #0d47a1;
        }

    .cell-my-draft {
        background-color: #fff3cd;
        color: #856404;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.15s;
    }

        .cell-my-draft:hover {
            background-color: #ffe8a1 !important;
        }

    .cell-occupied {
        background-color: #ffebee;
        color: #c62828;
        cursor: not-allowed;
        font-weight: 500;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-0 text-primary">Padel Ostrava – Rezervace kurtů</h1>
            <p class="text-muted small mb-0">Kliknutím na volný termín rezervujete kurt</p>
        </div>

        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label for="date" class="fw-bold mb-0">Datum:</label>
            <input type="date" id="date" name="date" class="form-control"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   min="@today.ToString("yyyy-MM-dd")"
                   onchange="this.form.submit()" />
        </form>
    </div>

    <div id="alertContainer"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!timeSlots.Any())
    {
        <div class="alert alert-warning text-center my-4 py-4 shadow-sm">
            Pro tento den již nejsou k dispozici žádné volné časové sloty.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-bordered align-middle text-center mb-0 bg-white table-fixed">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%;">Čas</th>
                        @foreach (var court in courts)
                        {
                            <th style="width: @courtColumnWidth;">Kurt č. @court.Number</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in timeSlots)
                    {
                        <tr>
                            <td class="fw-semibold bg-light">
                                @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                            </td>

                            @foreach (var court in courts)
                            {
                                var res = reservations.FirstOrDefault(r => r.CourtId == court.Id && r.TimeSlotId == slot.Id);

                                if (res != null)
                                {
                                    bool isMine = currentUserId.HasValue && res.UserId == currentUserId.Value;

                                    if (res.State == ReservationState.Draft)
                                    {
                                        if (isMine)
                                        {
                                            <td class="slot-cell">
                                                <div class="slot-content cell-my-draft"
                                                     onclick="startDraft(@court.Id, @court.Number, @slot.Id, '@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")', this)">
                                                    <span>Dokončit rezervaci</span>
                                                    <span class="small opacity-75 fw-normal" style="font-size: 0.75rem;">(rozpracováno)</span>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="slot-cell">
                                                <div class="slot-content cell-occupied">
                                                    <span>Obsazeno</span>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (isMine)
                                    {
                                        <td class="slot-cell">
                                            <div class="slot-content cell-mine"
                                                 data-bs-toggle="modal"
                                                 data-bs-target="#cancelModal"
                                                 data-reservation-id="@res.Id"
                                                 data-court-number="@court.Number"
                                                 data-slot-time="@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")">
                                                <span>Moje rezervace</span>
                                                <span class="small opacity-75 fw-normal" style="font-size: 0.75rem;">(kliknutím zrušit)</span>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="slot-cell">
                                            <div class="slot-content cell-occupied">
                                                <span>Obsazeno</span>
                                                <span class="small opacity-75 fw-normal" style="font-size: 0.75rem;">@res.User.Name @res.User.Surname[0].</span>
                                            </div>
                                        </td>
                                    }
                                }
                                else
                                {
                                    <td class="slot-cell">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <div class="slot-content cell-available"
                                                 onclick="startDraft(@court.Id, @court.Number, @slot.Id, '@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")', this)">
                                                Rezervovat
                                            </div>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Index", "Reservation", new { date = selectedDate.ToString("yyyy-MM-dd") })"
                                               class="slot-content cell-available text-decoration-none">
                                                Rezervovat
                                            </a>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<form id="afForm">@Html.AntiForgeryToken()</form>

<!-- Modal pro POTVRZENÍ DRAFT rezervace -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Potvrzení rezervace</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <form method="post" asp-action="ConfirmDraft">
                @Html.AntiForgeryToken()
                <div class="modal-body text-start">
                    <div class="alert alert-warning py-2 mb-3 d-flex justify-content-between align-items-center">
                        <small>Čas na dokončení:</small>
                        <strong id="timerDisplay" class="text-danger fs-6">05:00</strong>
                    </div>
                    <ul class="list-group mb-3">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Datum:</span>
                            <strong>@selectedDate.ToString("dd. MM. yyyy")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Kurt:</span>
                            <strong id="confirmModalCourt">---</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Čas:</span>
                            <strong id="confirmModalTime">---</strong>
                        </li>
                    </ul>
                    <input type="hidden" name="reservationId" class="modalReservationId" />
                    <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" onclick="cancelDraftAndClose()">Zrušit</button>
                    <button type="submit" id="btnConfirmSubmit" class="btn btn-success">Potvrdit rezervaci</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal pro ZRUŠENÍ CONFIRMED rezervace -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">Zrušení rezervace</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <form method="post" asp-action="Cancel">
                @Html.AntiForgeryToken()
                <div class="modal-body text-start">
                    <p class="mb-3">Opravdu chcete zrušit tuto rezervaci?</p>
                    <ul class="list-group mb-3">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Datum:</span>
                            <strong>@selectedDate.ToString("dd. MM. yyyy")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Kurt:</span>
                            <strong id="cancelModalCourt">---</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Čas:</span>
                            <strong id="cancelModalTime">---</strong>
                        </li>
                    </ul>
                    <input type="hidden" name="reservationId" id="cancelModalReservationId" />
                    <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ponechat</button>
                    <button type="submit" class="btn btn-danger">Zrušit rezervaci</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let countdownInterval;
        let currentDraftId = null;
        let activeDraftCell = null;

        async function startDraft(courtId, courtNumber, slotId, slotTime, element) {
            activeDraftCell = element;

            const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('courtId', courtId);
            formData.append('timeSlotId', slotId);
            formData.append('date', '@selectedDate.ToString("yyyy-MM-dd")');
            formData.append('__RequestVerificationToken', token);

            const res = await fetch('/Reservation/CreateDraft', { method: 'POST', body: formData });
            const data = await res.json();

            if (!data.success) {
                showToastError(data.message);
                return;
            }

            currentDraftId = data.reservationId;
            document.querySelectorAll('.modalReservationId').forEach(el => el.value = data.reservationId);
            document.getElementById('confirmModalCourt').textContent = 'Kurt č. ' + courtNumber;
            document.getElementById('confirmModalTime').textContent = slotTime;

            // Změna stavu buňky v tabulce na "Dokončit rezervaci"
            if (activeDraftCell) {
                activeDraftCell.className = "slot-content cell-my-draft";
                activeDraftCell.innerHTML = `<span>Dokončit rezervaci</span><span class="small opacity-75 fw-normal" style="font-size: 0.75rem;">(rozpracováno)</span>`;
            }

            startTimer(data.remainingSeconds, courtId, courtNumber, slotId, slotTime);
            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        }

        function startTimer(seconds, courtId, courtNumber, slotId, slotTime) {
            clearInterval(countdownInterval);
            let time = seconds;
            const display = document.getElementById('timerDisplay');
            const btnSubmit = document.getElementById('btnConfirmSubmit');
            btnSubmit.disabled = false;

            countdownInterval = setInterval(async () => {
                const m = Math.floor(time / 60).toString().padStart(2, '0');
                const s = (time % 60).toString().padStart(2, '0');
                display.textContent = `${m}:${s}`;

                if (--time < 0) {
                    clearInterval(countdownInterval);
                    display.textContent = "00:00";
                    btnSubmit.disabled = true;

                    // 1. Zrušení na serveru
                    await expireDraftOnServer();

                    // 2. Skrytí modalu
                    const modalEl = document.getElementById('confirmModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) {
                        modalInstance.hide();
                    }

                    // 3. Vracení buňky do stavu Volno
                    resetCellToAvailable(courtId, courtNumber, slotId, slotTime);

                    // 4. Zobrazení chybového oznamu
                    showToastError("Čas pro dokončení rezervace vypršel. Termín byl uvolněn.");
                }
            }, 1000);
        }

        async function expireDraftOnServer() {
            if (!currentDraftId) return;
            const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('reservationId', currentDraftId);
            formData.append('date', '@selectedDate.ToString("yyyy-MM-dd")');
            formData.append('__RequestVerificationToken', token);

            await fetch('/Reservation/CancelDraft', { method: 'POST', body: formData });
            currentDraftId = null;
        }

        function resetCellToAvailable(courtId, courtNumber, slotId, slotTime) {
            if (activeDraftCell) {
                activeDraftCell.className = "slot-content cell-available";
                activeDraftCell.innerHTML = "Rezervovat";
                activeDraftCell.onclick = function () {
                    startDraft(courtId, courtNumber, slotId, slotTime, this);
                };
            }
        }

        function showToastError(msg) {
            const container = document.getElementById('alertContainer');
            container.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            ${msg}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;
        }

        async function cancelDraftAndClose() {
            clearInterval(countdownInterval);
            await expireDraftOnServer();

            const modalEl = document.getElementById('confirmModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }

            if (activeDraftCell) {
                activeDraftCell.className = "slot-content cell-available";
                activeDraftCell.innerHTML = "Rezervovat";
            }
        }

        const confirmModalEl = document.getElementById('confirmModal');
        if (confirmModalEl) {
            confirmModalEl.addEventListener('hidden.bs.modal', function () {
                clearInterval(countdownInterval);
            });
        }

        const cancelModal = document.getElementById('cancelModal');
        if (cancelModal) {
            cancelModal.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                document.getElementById('cancelModalReservationId').value = trigger.getAttribute('data-reservation-id');
                document.getElementById('cancelModalCourt').textContent = 'Kurt č. ' + trigger.getAttribute('data-court-number');
                document.getElementById('cancelModalTime').textContent = trigger.getAttribute('data-slot-time');
            });
        }
    </script>
}