@model IEnumerable<reservation_system_for_padel.Models.Reservation>

@{
    ViewData["Title"] = "Moje rezervace";
    var now = DateTime.Now;
    var today = DateOnly.FromDateTime(now);
    var currentTime = TimeOnly.FromDateTime(now);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0 text-primary">Moje rezervace</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Zpět do kalendáře</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Nemáte žádné rezervace.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Datum</th>
                        <th>Čas</th>
                        <th>Kurt</th>
                        <th>Stav</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        bool isPast = res.Date < today || (res.Date == today && res.TimeSlot.EndTime <= currentTime);
                        bool isExpired = res.State == reservation_system_for_padel.Models.ReservationState.Expired || isPast;

                        <tr>
                            <td>@res.Date.ToString("dd. MM. yyyy")</td>
                            <td>@res.TimeSlot.StartTime.ToString("HH:mm") – @res.TimeSlot.EndTime.ToString("HH:mm")</td>
                            <td>Kurt č. @res.Court.Number</td>
                            <td>
                                @if (res.State == reservation_system_for_padel.Models.ReservationState.Canceled)
                                {
                                    <span class="badge bg-secondary">Zrušeno</span>
                                }
                                else if (res.State == reservation_system_for_padel.Models.ReservationState.Rejected)
                                {
                                    <span class="badge bg-danger">Zamítnuto</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-secondary text-light">Expirovaná</span>
                                }
                                else if (res.State == reservation_system_for_padel.Models.ReservationState.Confirmed)
                                {
                                    <span class="badge bg-success">Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@res.State</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!isExpired && res.State == reservation_system_for_padel.Models.ReservationState.Confirmed)
                                {
                                    <!-- Tlačítko pro QR kód -->
                                    <button type="button"
                                            class="btn btn-outline-dark btn-sm me-1"
                                            onclick="showQrModal(@res.Id, '@res.Court.Number', '@res.Date.ToString("dd.MM.yyyy")', '@res.TimeSlot.StartTime.ToString("HH:mm") - @res.TimeSlot.EndTime.ToString("HH:mm")')">
                                        Vstupní QR kód
                                    </button>

                                    <!-- Tlačítko pro zrušení -->
                                    <form method="post" asp-action="Cancel" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservationId" value="@res.Id" />
                                        <input type="hidden" name="date" value="@res.Date.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Opravdu chcete zrušit tuto rezervaci?');">
                                            Zrušit
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal pro zobrazení QR kódu -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center">
            <div class="modal-header">
                <h5 class="modal-title" id="qrModalLabel">Přístupový QR kód</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body py-4">
                <p id="qrDetails" class="fw-semibold mb-3"></p>
                <div class="d-flex justify-content-center">
                    <img id="qrImage" src="" alt="QR kód pro vstup" class="img-fluid border p-2 rounded shadow-sm" style="max-width: 250px;" />
                </div>
                <small class="text-muted d-block mt-3">Přiložte tento QR kód ke čtečce u vstupu na kurt.</small>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zavřít</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showQrModal(resId, courtNum, date, time) {
            document.getElementById('qrDetails').innerText = `Kurt č. ${courtNum} | ${date} (${time})`;
            document.getElementById('qrImage').src = `/Reservation/GetQrCode?reservationId=${resId}`;
            var myModal = new bootstrap.Modal(document.getElementById('qrModal'));
            myModal.show();
        }
    </script>
}